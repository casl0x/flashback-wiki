// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum EtatVie {
  EN_VIE
  MORT
  PARTI
  DISPARU
  PRISON
}

enum Role {
  civil
  illegal
}

enum CreatorType {
  ARTISTE
  EDITEUR
}

enum SocialPlatform {
  TWITTER
  TIKTOK
  YOUTUBE
  INSTAGRAM
  TWITCH
  AUTRE
}

model UserProfile {
  id                     String    @id @default(cuid())
  clerkUserId            String    @unique
  pseudo                 String?
  onboardingComplete     Boolean   @default(false)
  totalPoints            Int       @default(0)
  acceptedCount          Int       @default(0)
  badges                 String[]  @default([])
  lastSeenAnnouncementAt DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  creatorRoles  CreatorRole[]
  notifications Notification[]

  // Fiche joueur liée à ce compte (validée par un admin)
  playerId           String?             @unique @map("player_id")
  player             Player?             @relation(fields: [playerId], references: [id], onDelete: SetNull)
  playerLinkRequests PlayerLinkRequest[]
}

// Demande d'un utilisateur pour lier son compte à une fiche joueur
model PlayerLinkRequest {
  id         String    @id @default(cuid())
  status     String    @default("pending") // pending | accepted | rejected
  message    String?
  createdAt  DateTime  @default(now()) @map("created_at")
  reviewedAt DateTime? @map("reviewed_at")

  userProfileId String      @map("user_profile_id")
  userProfile   UserProfile @relation(fields: [userProfileId], references: [id], onDelete: Cascade)

  playerId String @map("player_id")
  player   Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([userProfileId, playerId])
  @@map("player_link_requests")
}

model Notification {
  id        String   @id @default(cuid())
  type      String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  userProfileId String
  userProfile   UserProfile @relation(fields: [userProfileId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model Announcement {
  id        String   @id @default(cuid())
  message   String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@map("announcements")
}

model CreatorRole {
  id            String      @id @default(cuid())
  type          CreatorType
  displayOnWiki Boolean     @default(false)
  status        String      @default("pending")
  bio           String?
  createdAt     DateTime    @default(now())

  userProfileId String
  userProfile   UserProfile   @relation(fields: [userProfileId], references: [id], onDelete: Cascade)
  socialLinks   SocialLink[] // ← déplacé ici
  posts         CreatorPost[]

  @@unique([userProfileId, type])
  @@map("creator_roles")
}

model CreatorPost {
  id        String          @id @default(cuid())
  type      CreatorType
  status    String          @default("pending")
  imageUrl  String?
  linkUrl   String?
  platform  SocialPlatform?
  caption   String?
  createdAt DateTime        @default(now())

  creatorRoleId String
  creatorRole   CreatorRole @relation(fields: [creatorRoleId], references: [id], onDelete: Cascade)

  characters CreatorPostCharacter[]

  @@map("creator_posts")
}

model CreatorPostCharacter {
  creatorPostId String
  characterId   String

  creatorPost CreatorPost @relation(fields: [creatorPostId], references: [id], onDelete: Cascade)
  character   Character   @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@id([creatorPostId, characterId])
  @@map("creator_post_characters")
}

model SocialLink {
  id        String         @id @default(cuid())
  platform  SocialPlatform
  url       String
  createdAt DateTime       @default(now())

  creatorRoleId String // ← lié au rôle, plus au profil
  creatorRole   CreatorRole @relation(fields: [creatorRoleId], references: [id], onDelete: Cascade)

  @@map("social_links")
}

model Version {
  id          String   @id // ex: "V1", "V2"
  label       String
  description String?
  color       String   @default("#8880a8")
  createdAt   DateTime @default(now()) @map("created_at")

  ordre     Int       @default(0) // ordre des bandes sur l'accueil
  dateDebut DateTime? @map("date_debut")
  dateFin   DateTime? @map("date_fin")
  imageUrl  String?   @map("image_url") // image d'ambiance
  enCours   Boolean   @default(false) @map("en_cours")

  characters       Character[]       @relation("CharacterVersions")
  characterGroupes CharacterGroupe[]
  suggestions      Suggestion[]

  @@map("versions")
}

model Player {
  id         String   @id @default(uuid())
  pseudo     String
  stream     Boolean  @default(false)
  lienChaine String?  @map("lien_chaine")
  reseaux    Json     @default("{}")
  badges     String[] @default([])
  createdAt  DateTime @default(now()) @map("created_at")

  characters   Character[]
  userProfile  UserProfile?
  linkRequests PlayerLinkRequest[]

  @@map("players")
}

model Character {
  id          String   @id @default(uuid())
  nom         String
  role        Role?
  description String?
  metier      String?
  lienReddif  String?  @map("lien_reddif")
  imageUrl    String?  @map("image_url")
  createdAt   DateTime @default(now()) @map("created_at")
  etatVie     EtatVie  @default(EN_VIE) @map("etat_vie")

  // Appartenances aux groupes, dans l'ordre chronologique (le plus grand ordre = l'actuel).
  // Remplace l'ancienne relation implicite "CharacterGroupes" : voir la note de migration.
  groupes CharacterGroupe[]

  sounds Sound[]

  playerId String? @map("player_id")
  player   Player? @relation(fields: [playerId], references: [id], onDelete: SetNull)

  // Un perso peut apparaître dans plusieurs versions (remplace l'ancienne version "Multiverse").
  versions Version[] @relation("CharacterVersions")

  relationsA Relation[] @relation("PersonnageA")
  relationsB Relation[] @relation("PersonnageB")

  locationX Float? @map("location_x")
  locationY Float? @map("location_y")

  suggestions  Suggestion[]
  creatorPosts CreatorPostCharacter[]

  @@map("characters")
}

model Relation {
  id                  String   @id @default(uuid())
  typeRelation        String?  @map("type_relation")
  typeRelationInverse String?
  createdAt           DateTime @default(now()) @map("created_at")

  personnageAId String    @map("personnage_a")
  personnageA   Character @relation("PersonnageA", fields: [personnageAId], references: [id], onDelete: Cascade)

  personnageBId String    @map("personnage_b")
  personnageB   Character @relation("PersonnageB", fields: [personnageBId], references: [id], onDelete: Cascade)

  @@unique([personnageAId, personnageBId])
  @@map("relations")
}

model Groupe {
  id          String   @id @default(cuid())
  slug        String   @unique
  nom         String
  description String?
  imageUrl    String?  @map("image_url")
  color       String?
  createdAt   DateTime @default(now()) @map("created_at")

  members CharacterGroupe[]
  grades  GroupeGrade[]

  @@map("groupes")
}

// Grades d'un groupe, du plus haut (ordre 0) au plus bas
model GroupeGrade {
  id      String  @id @default(cuid())
  nom     String
  ordre   Int     @default(0)
  niveau  String? // "commandement" | "encadrement" | "agents" (couleur sur la page groupe)

  groupeId String @map("groupe_id")
  groupe   Groupe @relation(fields: [groupeId], references: [id], onDelete: Cascade)

  members CharacterGroupe[]

  @@unique([groupeId, nom])
  @@map("groupe_grades")
}

// Appartenance d'un perso à un groupe, avec son grade et son matricule dans ce groupe
model CharacterGroupe {
  id        String  @id @default(uuid())
  ordre     Int     @default(0) // ordre chronologique pour ce perso
  matricule String?

  characterId String    @map("character_id")
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  groupeId String @map("groupe_id")
  groupe   Groupe @relation(fields: [groupeId], references: [id], onDelete: Cascade)

  gradeId String?      @map("grade_id")
  grade   GroupeGrade? @relation(fields: [gradeId], references: [id], onDelete: SetNull)

  // Version pendant laquelle le perso était dans ce groupe (ex. SASP en V5, BCSO en V6).
  versionId String?  @map("version_id")
  version   Version? @relation(fields: [versionId], references: [id], onDelete: SetNull)

  @@unique([characterId, groupeId, versionId])
  @@index([groupeId])
  @@map("character_groupes")
}

// Sons associés à un perso (page Musiques « par personnage » + éditeur de fiche)
model Sound {
  id        String   @id @default(cuid())
  titre     String
  artiste   String?
  url       String
  platform  String? // "spotify" | "youtube" | "autre"
  ordre     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  characterId String    @map("character_id")
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@map("sounds")
}

model Suggestion {
  id          String     @id @default(cuid())
  clerkUserId String?
  characterId String?
  character   Character? @relation(fields: [characterId], references: [id], onDelete: Cascade)
  nom         String?
  metier      String?
  groupe      String?
  description String?
  note        String?
  role        Role?
  etatVie     EtatVie?   @map("etat_vie")
  joueur      String?
  versionId   String?    @map("version_id")
  version     Version?   @relation(fields: [versionId], references: [id], onDelete: SetNull)
  lienReddif  String?    @map("lien_reddif")
  status      String     @default("pending") // pending | accepted | rejected
  createdAt   DateTime   @default(now())

  // Refus : motif court (liste fixe côté admin) + message envoyé à l'auteur en Notification
  rejectReason     String?   @map("reject_reason")
  moderatorMessage String?   @map("moderator_message")
  reviewedAt       DateTime? @map("reviewed_at")
}

model ChangelogEntry {
  id        String   @id @default(uuid())
  type      String // "add_global" | "add_relation" | "add_lieu" | "edit_info" | "edit_relation" | "edit_lieu" | "version"
  label     String // nom du perso ou de la version
  detail    String? // info supplémentaire optionnelle
  createdAt DateTime @default(now()) @map("created_at")

  @@map("changelog_entries")
}

model Poll {
  id        String       @id @default(cuid())
  question  String
  active    Boolean      @default(true)
  createdAt DateTime     @default(now())
  endsAt    DateTime?
  // Public : les visiteurs non connectés peuvent aussi voter / proposer
  isPublic  Boolean      @default(false)
  // Les votants peuvent ajouter leurs propres options
  allowProposals Boolean @default(false)
  options   PollOption[]
}

model PollOption {
  id     String     @id @default(cuid())
  label  String
  pollId String
  // Auteur de la proposition (null = option créée par l'admin)
  proposedBy String?
  poll   Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes  PollVote[]
}

model PollVote {
  id        String     @id @default(cuid())
  userId    String
  optionId  String
  option    PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())

  @@unique([userId, optionId])
}
